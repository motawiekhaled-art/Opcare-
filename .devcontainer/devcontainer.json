{
  "name": "Opcare DAQ demo",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "hostRequirements": { "cpus": 2 },
  "postCreateCommand": "pip install --user -r requirements-demo.txt",
  "postAttachCommand": "bash .devcontainer/start-demo.sh",
  "forwardPorts": [8080],
  "portsAttributes": {
    "8080": { "label": "Opcare DAQ demo", "onAutoForward": "openBrowser" }
  },
  "customizations": {
    "codespaces": { "openFiles": [".devcontainer/README.md"] }
  }
}
