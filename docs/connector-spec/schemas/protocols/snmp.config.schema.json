{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opcaresystems.com/daq/connector/1.0/protocols/snmp.config.schema.json",
  "title": "SNMP manager configuration",
  "allOf": [
    {
      "$ref": "../config-envelope.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "snmp"
        },
        "connection": {
          "type": "object",
          "properties": {
            "version": {
              "enum": [
                "1",
                "2c",
                "3"
              ],
              "default": "2c"
            },
            "port": {
              "$ref": "../common.schema.json#/$defs/port",
              "default": 161
            },
            "community_ref": {
              "$ref": "../common.schema.json#/$defs/secretRef"
            },
            "v3": {
              "type": "object",
              "properties": {
                "username": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 32
                },
                "security_level": {
                  "enum": [
                    "noAuthNoPriv",
                    "authNoPriv",
                    "authPriv"
                  ],
                  "default": "authPriv"
                },
                "auth_protocol": {
                  "enum": [
                    "MD5",
                    "SHA",
                    "SHA-224",
                    "SHA-256",
                    "SHA-384",
                    "SHA-512"
                  ],
                  "default": "SHA-256"
                },
                "auth_password_ref": {
                  "$ref": "../common.schema.json#/$defs/secretRef"
                },
                "priv_protocol": {
                  "enum": [
                    "AES"
                  ],
                  "default": "AES"
                },
                "priv_password_ref": {
                  "$ref": "../common.schema.json#/$defs/secretRef"
                },
                "context_name": {
                  "type": "string",
                  "maxLength": 32,
                  "default": ""
                }
              },
              "required": [
                "username"
              ],
              "additionalProperties": false,
              "allOf": [
                {
                  "if": {
                    "not": {
                      "properties": {
                        "security_level": {
                          "const": "noAuthNoPriv"
                        }
                      },
                      "required": [
                        "security_level"
                      ]
                    }
                  },
                  "then": {
                    "required": [
                      "auth_password_ref"
                    ]
                  }
                },
                {
                  "if": {
                    "not": {
                      "properties": {
                        "security_level": {
                          "enum": [
                            "noAuthNoPriv",
                            "authNoPriv"
                          ]
                        }
                      },
                      "required": [
                        "security_level"
                      ]
                    }
                  },
                  "then": {
                    "required": [
                      "priv_password_ref"
                    ]
                  }
                }
              ]
            },
            "devices": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                  },
                  "host": {
                    "$ref": "../common.schema.json#/$defs/host"
                  },
                  "port": {
                    "$ref": "../common.schema.json#/$defs/port"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "id",
                  "host"
                ],
                "additionalProperties": false
              }
            },
            "max_oids_per_request": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            },
            "max_repetitions": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 25
            },
            "retries": {
              "type": "integer",
              "minimum": 0,
              "maximum": 5,
              "default": 1
            },
            "traps": {
              "type": "object",
              "properties": {
                "bind_host": {
                  "type": "string",
                  "default": "0.0.0.0",
                  "maxLength": 64
                },
                "bind_port": {
                  "$ref": "../common.schema.json#/$defs/port"
                },
                "community_ref": {
                  "$ref": "../common.schema.json#/$defs/secretRef"
                }
              },
              "required": [
                "bind_port"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "version",
            "devices"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "version": {
                    "enum": [
                      "1",
                      "2c"
                    ]
                  }
                }
              },
              "then": {
                "required": [
                  "community_ref"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "version": {
                    "const": "3"
                  }
                }
              },
              "then": {
                "required": [
                  "v3"
                ]
              }
            }
          ]
        },
        "acquisition": {
          "allOf": [
            {
              "$ref": "../common.schema.json#/$defs/acquisitionCommon"
            }
          ],
          "properties": {},
          "unevaluatedProperties": false
        },
        "points": {
          "items": {
            "properties": {
              "address": {
                "type": "object",
                "properties": {
                  "device": {
                    "type": "string"
                  },
                  "oid": {
                    "type": "string",
                    "maxLength": 300,
                    "pattern": "^\\.?[0-2](\\.(0|[1-9][0-9]{0,9}))+$"
                  },
                  "transform": {
                    "enum": [
                      "none",
                      "rate"
                    ],
                    "default": "none"
                  }
                },
                "required": [
                  "device",
                  "oid"
                ],
                "additionalProperties": false
              }
            }
          }
        }
      }
    }
  ]
}
