{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opcaresystems.com/daq/connector/1.0/protocols/modbus.config.schema.json",
  "title": "Modbus TCP / RTU configuration",
  "allOf": [
    {
      "$ref": "../config-envelope.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "modbus"
        },
        "connection": {
          "type": "object",
          "properties": {
            "transport": {
              "enum": [
                "tcp",
                "rtu"
              ]
            },
            "host": {
              "$ref": "../common.schema.json#/$defs/host"
            },
            "port": {
              "$ref": "../common.schema.json#/$defs/port",
              "default": 502
            },
            "serial": {
              "type": "object",
              "properties": {
                "device": {
                  "type": "string"
                },
                "baud": {
                  "type": "integer",
                  "minimum": 300,
                  "maximum": 921600,
                  "default": 9600
                },
                "parity": {
                  "enum": [
                    "N",
                    "E",
                    "O"
                  ],
                  "default": "E"
                },
                "data_bits": {
                  "enum": [
                    7,
                    8
                  ],
                  "default": 8
                },
                "stop_bits": {
                  "enum": [
                    1,
                    2
                  ],
                  "default": 1
                }
              },
              "required": [
                "device"
              ],
              "additionalProperties": false
            },
            "devices": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                  },
                  "unit_id": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 247
                  },
                  "name": {
                    "type": "string"
                  }
                },
                "required": [
                  "id",
                  "unit_id"
                ],
                "additionalProperties": false
              }
            },
            "max_registers_per_read": {
              "type": "integer",
              "minimum": 1,
              "maximum": 125,
              "default": 100
            },
            "max_bits_per_read": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000,
              "default": 1000
            },
            "max_gap": {
              "type": "integer",
              "minimum": 0,
              "maximum": 100,
              "default": 10
            },
            "inter_request_delay_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 10000
            }
          },
          "required": [
            "transport",
            "devices"
          ],
          "additionalProperties": false,
          "allOf": [
            {
              "if": {
                "properties": {
                  "transport": {
                    "const": "tcp"
                  }
                }
              },
              "then": {
                "required": [
                  "host"
                ]
              }
            },
            {
              "if": {
                "properties": {
                  "transport": {
                    "const": "rtu"
                  }
                }
              },
              "then": {
                "required": [
                  "serial"
                ]
              }
            }
          ]
        },
        "acquisition": {
          "allOf": [
            {
              "$ref": "../common.schema.json#/$defs/acquisitionCommon"
            }
          ],
          "properties": {},
          "unevaluatedProperties": false
        },
        "points": {
          "items": {
            "properties": {
              "address": {
                "type": "object",
                "properties": {
                  "device": {
                    "type": "string"
                  },
                  "table": {
                    "enum": [
                      "coil",
                      "discrete_input",
                      "holding_register",
                      "input_register"
                    ]
                  },
                  "address": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65535
                  },
                  "encoding": {
                    "enum": [
                      "bool",
                      "bit",
                      "int16",
                      "uint16",
                      "int32",
                      "uint32",
                      "int64",
                      "uint64",
                      "float32",
                      "float64",
                      "string"
                    ]
                  },
                  "word_order": {
                    "enum": [
                      "big",
                      "little"
                    ],
                    "default": "big"
                  },
                  "byte_order": {
                    "enum": [
                      "big",
                      "little"
                    ],
                    "default": "big"
                  },
                  "bit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 15
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 125
                  }
                },
                "required": [
                  "device",
                  "table",
                  "address",
                  "encoding"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "encoding": {
                          "const": "bit"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "bit"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "encoding": {
                          "const": "string"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "length"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "table": {
                          "enum": [
                            "coil",
                            "discrete_input"
                          ]
                        }
                      }
                    },
                    "then": {
                      "properties": {
                        "encoding": {
                          "const": "bool"
                        }
                      }
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
