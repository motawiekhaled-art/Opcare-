{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opcaresystems.com/daq/connector/1.0/protocols/udp.config.schema.json",
  "title": "UDP datagram listener configuration",
  "allOf": [
    {
      "$ref": "../config-envelope.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "udp"
        },
        "connection": {
          "type": "object",
          "properties": {
            "bind_host": {
              "type": "string",
              "default": "0.0.0.0",
              "maxLength": 64
            },
            "bind_port": {
              "$ref": "../common.schema.json#/$defs/port"
            },
            "senders": {
              "type": "array",
              "minItems": 1,
              "maxItems": 500,
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"
                  },
                  "host": {
                    "type": "string",
                    "minLength": 2,
                    "maxLength": 64,
                    "pattern": "^([0-9]{1,3}(\\.[0-9]{1,3}){3}(/[0-9]{1,2})?|[0-9A-Fa-f:]*:[0-9A-Fa-f:.]*(/[0-9]{1,3})?)$"
                  },
                  "name": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "id",
                  "host"
                ],
                "additionalProperties": false
              }
            },
            "silence_timeout_s": {
              "type": "integer",
              "minimum": 0,
              "maximum": 86400,
              "default": 60
            },
            "max_datagram_bytes": {
              "type": "integer",
              "minimum": 64,
              "maximum": 65507,
              "default": 8192
            },
            "text_encoding": {
              "enum": [
                "utf-8",
                "ascii",
                "latin-1"
              ],
              "default": "utf-8"
            },
            "syslog": {
              "type": "object",
              "properties": {
                "min_severity": {
                  "enum": [
                    "emergency",
                    "alert",
                    "critical",
                    "error",
                    "warning",
                    "notice",
                    "info",
                    "debug"
                  ],
                  "default": "warning"
                }
              },
              "additionalProperties": false
            }
          },
          "required": [
            "bind_port",
            "senders"
          ],
          "additionalProperties": false
        },
        "acquisition": {
          "allOf": [
            {
              "$ref": "../common.schema.json#/$defs/acquisitionCommon"
            }
          ],
          "properties": {},
          "unevaluatedProperties": false
        },
        "points": {
          "items": {
            "properties": {
              "address": {
                "type": "object",
                "properties": {
                  "device": {
                    "type": "string"
                  },
                  "format": {
                    "enum": [
                      "json",
                      "delimited",
                      "nmea",
                      "binary",
                      "raw",
                      "syslog"
                    ]
                  },
                  "prefix": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 64
                  },
                  "prefix_hex": {
                    "type": "string",
                    "pattern": "^([0-9a-fA-F]{2}){1,32}$"
                  },
                  "value_pointer": {
                    "type": "string",
                    "pattern": "^(/[^/]*)*$"
                  },
                  "timestamp_pointer": {
                    "type": "string",
                    "pattern": "^(/[^/]*)*$"
                  },
                  "timestamp_format": {
                    "enum": [
                      "rfc3339",
                      "epoch_ms",
                      "epoch_s"
                    ]
                  },
                  "match_pointer": {
                    "type": "string",
                    "pattern": "^(/[^/]*)*$"
                  },
                  "match_value": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "delimiter": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 4,
                    "default": ","
                  },
                  "field": {
                    "oneOf": [
                      {
                        "type": "integer",
                        "minimum": 0,
                        "maximum": 1000
                      },
                      {
                        "enum": [
                          "severity",
                          "facility",
                          "message",
                          "app_name",
                          "hostname"
                        ]
                      }
                    ]
                  },
                  "sentence": {
                    "type": "string",
                    "pattern": "^[A-Z0-9]{3,5}$"
                  },
                  "coordinate": {
                    "type": "boolean",
                    "default": false
                  },
                  "offset": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 65506
                  },
                  "encoding": {
                    "enum": [
                      "bool",
                      "bit",
                      "int8",
                      "uint8",
                      "int16",
                      "uint16",
                      "int32",
                      "uint32",
                      "int64",
                      "uint64",
                      "float32",
                      "float64",
                      "string"
                    ]
                  },
                  "byte_order": {
                    "enum": [
                      "big",
                      "little"
                    ],
                    "default": "big"
                  },
                  "bit": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 7
                  },
                  "length": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1024
                  },
                  "match": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  }
                },
                "required": [
                  "device",
                  "format"
                ],
                "additionalProperties": false,
                "allOf": [
                  {
                    "if": {
                      "properties": {
                        "format": {
                          "const": "json"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "value_pointer"
                      ],
                      "dependentRequired": {
                        "match_pointer": [
                          "match_value"
                        ],
                        "match_value": [
                          "match_pointer"
                        ]
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "format": {
                          "const": "delimited"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "field"
                      ],
                      "properties": {
                        "field": {
                          "type": "integer"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "format": {
                          "const": "nmea"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "sentence",
                        "field"
                      ],
                      "properties": {
                        "field": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "format": {
                          "const": "binary"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "offset",
                        "encoding"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "format": {
                          "const": "syslog"
                        }
                      }
                    },
                    "then": {
                      "required": [
                        "field"
                      ],
                      "properties": {
                        "field": {
                          "type": "string"
                        }
                      }
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "encoding": {
                          "const": "bit"
                        }
                      },
                      "required": [
                        "encoding"
                      ]
                    },
                    "then": {
                      "required": [
                        "bit"
                      ]
                    }
                  },
                  {
                    "if": {
                      "properties": {
                        "encoding": {
                          "const": "string"
                        }
                      },
                      "required": [
                        "encoding"
                      ]
                    },
                    "then": {
                      "required": [
                        "length"
                      ]
                    }
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
