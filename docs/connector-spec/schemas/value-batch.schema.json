{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.opcaresystems.com/daq/connector/1.0/value-batch.schema.json",
  "title": "Value batch (topic opcare/v1/{site}/data/{source_id})",
  "type": "object",
  "properties": {
    "spec": {
      "$ref": "common.schema.json#/$defs/spec"
    },
    "src": {
      "$ref": "common.schema.json#/$defs/sourceId"
    },
    "boot": {
      "$ref": "common.schema.json#/$defs/uuid"
    },
    "seq": {
      "type": "integer",
      "minimum": 1
    },
    "sent": {
      "$ref": "common.schema.json#/$defs/timestamp"
    },
    "values": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5000,
      "items": {
        "type": "object",
        "properties": {
          "t": {
            "$ref": "common.schema.json#/$defs/tagId"
          },
          "v": {
            "type": [
              "number",
              "integer",
              "boolean",
              "string",
              "null"
            ]
          },
          "q": {
            "$ref": "common.schema.json#/$defs/quality"
          },
          "ts": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "rx": {
            "$ref": "common.schema.json#/$defs/timestamp"
          },
          "f": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 32
            },
            "maxItems": 16
          }
        },
        "required": [
          "t",
          "v",
          "q",
          "ts",
          "rx"
        ],
        "additionalProperties": false,
        "if": {
          "properties": {
            "q": {
              "enum": [
                0,
                4,
                12,
                24,
                28
              ]
            }
          }
        },
        "else": {
          "properties": {
            "v": {
              "not": {
                "type": "null"
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "spec",
    "src",
    "boot",
    "seq",
    "sent",
    "values"
  ],
  "additionalProperties": false
}
